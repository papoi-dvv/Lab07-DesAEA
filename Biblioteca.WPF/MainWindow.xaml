<Window x:Class="Biblioteca.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca - Gestión de préstamos"
        Height="760" Width="1180" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Background="#E9EFF5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryBrush}" Padding="22,16">
            <StackPanel>
                <TextBlock Text="BibliotecaDB" Foreground="White" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="Libros, socios, préstamos, devoluciones y reportes" Foreground="#DCEAF5" FontSize="13" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="14" Background="White">
            <TabItem Header="Libros">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Mantenimiento de libros" FontSize="18" FontWeight="SemiBold" Margin="4,0,4,10" />
                            <TextBlock Text="Título" Margin="4,4,4,0" />
                            <TextBox x:Name="TxtLibroTitulo" />
                            <TextBlock Text="ISBN" Margin="4,4,4,0" />
                            <TextBox x:Name="TxtLibroIsbn" />
                            <TextBlock Text="Autor" Margin="4,4,4,0" />
                            <ComboBox x:Name="CmbLibroAutor" DisplayMemberPath="Nombre" SelectedValuePath="AutorId" />
                            <TextBlock Text="Ejemplares" Margin="4,4,4,0" />
                            <TextBox x:Name="TxtLibroEjemplares" Text="0" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Nuevo" Click="BtnNuevoLibro_Click" />
                                <Button Content="Guardar" Click="BtnGuardarLibro_Click" />
                                <Button Content="Dar de baja" Background="#A33A3A" Click="BtnEliminarLibro_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="4,0,4,8">
                            <Button Content="Buscar" DockPanel.Dock="Right" Click="BtnBuscarLibro_Click" />
                            <Button Content="Mostrar todos" DockPanel.Dock="Right" Click="BtnListarLibros_Click" />
                            <TextBox x:Name="TxtBuscarLibro" ToolTip="Buscar por título o autor" />
                        </DockPanel>
                        <DataGrid x:Name="DgLibros" Grid.Row="1" SelectionChanged="DgLibros_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding LibroId}" Width="55" />
                                <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*" />
                                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="145" />
                                <DataGridTextColumn Header="Autor" Binding="{Binding NombreAutor}" Width="170" />
                                <DataGridTextColumn Header="Stock" Binding="{Binding Ejemplares}" Width="65" />
                                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="65" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Socios">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Mantenimiento de socios" FontSize="18" FontWeight="SemiBold" Margin="4,0,4,10" />
                            <TextBlock Text="DNI" Margin="4,4,4,0" />
                            <TextBox x:Name="TxtSocioDni" />
                            <TextBlock Text="Nombre" Margin="4,4,4,0" />
                            <TextBox x:Name="TxtSocioNombre" />
                            <TextBlock Text="Correo electrónico" Margin="4,4,4,0" />
                            <TextBox x:Name="TxtSocioEmail" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Nuevo" Click="BtnNuevoSocio_Click" />
                                <Button Content="Guardar" Click="BtnGuardarSocio_Click" />
                                <Button Content="Dar de baja" Background="#A33A3A" Click="BtnEliminarSocio_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="4,0,4,8">
                            <Button Content="Buscar" DockPanel.Dock="Right" Click="BtnBuscarSocio_Click" />
                            <Button Content="Mostrar todos" DockPanel.Dock="Right" Click="BtnListarSocios_Click" />
                            <TextBox x:Name="TxtBuscarSocio" ToolTip="Buscar por nombre o DNI" />
                        </DockPanel>
                        <DataGrid x:Name="DgSocios" Grid.Row="1" SelectionChanged="DgSocios_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding SocioId}" Width="55" />
                                <DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="120" />
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                                <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="230" />
                                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="65" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Préstamos">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Registrar préstamo" FontSize="20" FontWeight="SemiBold" Margin="4,0,4,12" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Background="{StaticResource PanelBrush}" Margin="0,0,12,0">
                            <TextBlock Text="Socio activo" />
                            <ComboBox x:Name="CmbPrestamoSocio" DisplayMemberPath="Nombre" SelectedValuePath="SocioId" />
                            <TextBlock Text="Fecha de préstamo" Margin="4,10,4,0" />
                            <DatePicker x:Name="DpFechaPrestamo" />
                            <TextBlock Text="Fecha límite" Margin="4,10,4,0" />
                            <DatePicker x:Name="DpFechaLimite" />
                            <TextBlock Text="Seleccione uno o varios libros en la tabla." TextWrapping="Wrap" Foreground="#465A6B" Margin="4,16,4,0" />
                        </StackPanel>
                        <DataGrid x:Name="DgPrestamoLibros" Grid.Column="1" SelectionMode="Extended">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding LibroId}" Width="55" />
                                <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*" />
                                <DataGridTextColumn Header="Autor" Binding="{Binding NombreAutor}" Width="190" />
                                <DataGridTextColumn Header="Disponibles" Binding="{Binding Ejemplares}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Actualizar catálogos" Click="BtnActualizarPrestamo_Click" />
                        <Button Content="Registrar préstamo" Click="BtnRegistrarPrestamo_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Devoluciones">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Registrar devolución" FontSize="20" FontWeight="SemiBold" Margin="4,0,4,12" />
                    <DockPanel Grid.Row="1" Margin="4,0,4,10">
                        <Button Content="Buscar préstamo" DockPanel.Dock="Right" Click="BtnBuscarPrestamo_Click" />
                        <TextBox x:Name="TxtPrestamoId" ToolTip="Número del préstamo" />
                    </DockPanel>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LblDatosPrestamo" Text="Ingrese el número del préstamo." Margin="4,2,4,8" FontWeight="SemiBold" />
                        <DataGrid x:Name="DgDetallePrestamo" Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Libro ID" Binding="{Binding LibroId}" Width="90" />
                                <DataGridTextColumn Header="Libro" Binding="{Binding TituloLibro}" Width="*" />
                                <DataGridTextColumn Header="Fecha de devolución" Binding="{Binding FechaDevolucion, StringFormat={}{0:dd/MM/yyyy}}" Width="170" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <DockPanel Grid.Row="3" Margin="4,12,4,0">
                        <TextBlock x:Name="LblMulta" Text="Multa: S/ 0.00" FontSize="18" FontWeight="SemiBold" Foreground="#A33A3A" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="Fecha de devolución" VerticalAlignment="Center" Margin="8,0" />
                            <DatePicker x:Name="DpFechaDevolucion" Width="145" />
                            <Button Content="Registrar devolución" Click="BtnRegistrarDevolucion_Click" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Reporte">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="4,0,4,10">
                        <Button Content="Consultar" DockPanel.Dock="Right" Click="BtnGenerarReporte_Click" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Desde" VerticalAlignment="Center" Margin="4" />
                            <DatePicker x:Name="DpReporteInicio" Width="145" />
                            <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="12,4,4,4" />
                            <DatePicker x:Name="DpReporteFin" Width="145" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="DgReporte" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Préstamo" Binding="{Binding PrestamoId}" Width="85" />
                            <DataGridTextColumn Header="Socio" Binding="{Binding NombreSocio}" Width="220" />
                            <DataGridTextColumn Header="Libro" Binding="{Binding TituloLibro}" Width="*" />
                            <DataGridTextColumn Header="Fecha límite" Binding="{Binding FechaLimite, StringFormat={}{0:dd/MM/yyyy}}" Width="130" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#D7E2EC" Padding="12,7">
            <TextBlock x:Name="LblEstado" Text="Listo" Foreground="#30485D" />
        </Border>
    </Grid>
</Window>
